[gd_resource type="Resource" script_class="CreatureDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://data/definitions/creature_definition.gd" id="1_creature"]
[ext_resource type="Script" path="res://data/definitions/creature_behavior_profile.gd" id="2_behavior"]

[sub_resource type="Resource" id="Resource_slime_behavior"]
script = ExtResource("2_behavior")
is_predator = false
is_prey = true

[resource]
script = ExtResource("1_creature")
content_id = &"creature.slime"
display_name_key = &"creature.slime.name"
developer_notes = "U1.9k typed Slime stats/behavior authority. Presentation and hop/drop execution remain behind the legacy adapter."
base_max_hp = 110
move_speed = 85.0
base_attack_power = 9
behavior_profile = SubResource("Resource_slime_behavior")
drop_item_id = &"item.berry"
skill_ids = Array[StringName]([&"skill.slime.hop"])
